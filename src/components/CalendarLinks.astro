---
// 刀剣のカレンダー購読のボタン（webcal://）と、URLで追加するためのリンク（https://）。
// 公開先（astro.config.mjs の site）が設定されていればビルド時に絶対URLを入れ、
// 未設定のときは、ブラウザで開いているページのURLから組み立てる。
// slot には、並べて置くボタン（公式の画像ページへのリンクなど）を入れる。
interface Props {
  swordId: string;
}

const { swordId } = Astro.props;
const path = `/swords/${swordId}.ics`;
const httpsUrl = Astro.site ? new URL(path, Astro.site).href : null;
const webcalUrl = httpsUrl ? httpsUrl.replace(/^https?:/, "webcal:") : null;
---

<div data-calendar-links data-ics-path={path}>
  <div class="actions">
    <a class="btn" data-primary href={webcalUrl ?? path} data-calendar-webcal>
      この刀の展示予定をカレンダーで受け取る
      <small>カレンダーアプリで購読（.ics）</small>
    </a>
    <slot />
  </div>
  <p class="note-line">
    Google カレンダーなどでは、<a href={httpsUrl ?? path} data-calendar-https>カレンダーのURL</a
    >を「URLで追加」に貼り付けてください。展示情報が更新されると、カレンダーにも反映されます。
  </p>
</div>

<script>
  // site が未設定でも、開いているページのURLから絶対URLを組み立てる
  for (const section of document.querySelectorAll<HTMLElement>("[data-calendar-links]")) {
    const path = section.dataset.icsPath;
    if (!path) continue;
    // ビルド時に絶対URLを入れられなかった（相対パスのままの）リンクだけを書き換える
    const https = new URL(path, window.location.href).href;
    const webcal = section.querySelector<HTMLAnchorElement>("[data-calendar-webcal]");
    const httpsLink = section.querySelector<HTMLAnchorElement>("[data-calendar-https]");
    if (httpsLink?.getAttribute("href")?.startsWith("/")) httpsLink.href = https;
    if (webcal?.getAttribute("href")?.startsWith("/")) webcal.href = https.replace(/^https?:/, "webcal:");
  }
</script>
