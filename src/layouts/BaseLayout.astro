---
// 共通レイアウト（案A）。ヘッダー（ロゴ・ナビ・スマホ用メニュー）とフッター（免責文）。
import "../styles/global.css";
import { allOgCards } from "../lib/og/collection";
import { defaultDescription } from "../lib/og/card";
import { ogPage, ogUrls } from "../lib/og/meta";

interface Props {
  title?: string;
  description?: string;
  /** ナビで現在のページを示す */
  current?: "search" | "exhibitions" | "map";
  /**
   * main の組み方。narrow（既定）は本文の幅に収めて余白を付ける。
   * full はページ側で .wrap を使って組む（トップ・刀剣詳細など）。
   */
  width?: "narrow" | "full";
}

const { title, description, current, width = "narrow" } = Astro.props;
const siteName = "訪剣 −TOKEN−";
const pageTitle = title ? `${title}｜${siteName}` : siteName;
// シェア時のプレビュー（OGP、T-208）。刀剣・刀匠・展覧会のページには、ビルド時に生成した画像を付ける
const og = ogUrls(Astro.url.pathname, Astro.site);
// 説明文をページ側で渡していない刀匠・展覧会のページは、画像と同じ内容から説明文を作る
const page = ogPage(Astro.url.pathname);
const pageCard = page ? (await allOgCards())[page.kind].get(page.id) : undefined;
const pageDescription =
  description ??
  (page && pageCard ? defaultDescription(page.kind, pageCard) : null) ??
  "推しの刀が、いま・どこで・いつまで見られるか。号・銘・刀匠の名から探せます。";

const navItems = [
  { key: "search", href: "/swords", label: "刀を探す" },
  { key: "exhibitions", href: "/exhibitions", label: "展覧会" },
  { key: "map", href: "/map", label: "地図・訪剣帖" },
] as const;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <title>{pageTitle}</title>
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={Astro.url.pathname === "/" ? "website" : "article"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {og.url && <meta property="og:url" content={og.url} />}
    {og.image && <meta property="og:image" content={og.image} />}
    {og.image && <meta property="og:image:width" content="1200" />}
    {og.image && <meta property="og:image:height" content="630" />}
    {og.image && <meta property="og:image:alt" content={title ?? siteName} />}
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content={og.image ? "summary_large_image" : "summary"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 書体は使う太さだけを読み込む（docs/design/system.md §2） -->
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;600;800&family=Yuji+Syuku&family=Zen+Kaku+Gothic+New:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="site-hdr">
      <div class="wrap">
        <a class="logo" href="/">訪剣<small>−TOKEN−</small></a>
        <nav class="site-nav" aria-label="サイト内">
          {
            navItems.map((item) => (
              <a href={item.href} aria-current={current === item.key ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <details class="site-menu">
          <summary aria-label="メニューを開く">目次</summary>
          <nav aria-label="サイト内（メニュー）">
            <ul>
              {
                navItems.map((item) => (
                  <li>
                    <a href={item.href} aria-current={current === item.key ? "page" : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <main class:list={["flex-1", width === "narrow" && "wrap max-w-3xl py-6"]}>
      <slot />
    </main>
    <footer class="site-ftr">
      <div class="wrap">
        <p>訪剣 −TOKEN−　展示情報は各館の公式サイトで最終確認してください。</p>
        <ul class="mt-2 flex list-none flex-wrap gap-x-5 p-0">
          <li><a class="inline-block py-1" href="/about">このサイトについて（免責・出典）</a></li>
          <li><a class="inline-block py-1" href="/privacy">プライバシー</a></li>
        </ul>
      </div>
    </footer>
    <script>
      // スマホ用メニュー：項目を選んだら閉じる（同じページ内の移動でも閉じるように）
      for (const menu of document.querySelectorAll<HTMLDetailsElement>(".site-menu")) {
        menu.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest("a")) menu.open = false;
        });
      }
    </script>
  </body>
</html>
