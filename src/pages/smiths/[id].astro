---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sources from "../../components/Sources.astro";
import { swordDisplayName } from "../../lib/display-name";

export const getStaticPaths = (async () => {
  const smiths = await getCollection("smiths");
  return smiths.map((entry) => ({ params: { id: entry.id }, props: { smith: entry.data } }));
}) satisfies GetStaticPaths;

const { smith } = Astro.props;
const smiths = (await getCollection("smiths")).map((e) => e.data);
const swords = (await getCollection("swords")).map((e) => e.data);
const exhibitions = (await getCollection("exhibitions")).map((e) => e.data);

const attributed = swords.flatMap((sword) =>
  sword.attributions
    .filter((a) => a.smith_id === smith.id)
    .map((a) => ({ sword, basis: a.basis, name: swordDisplayName(sword, smiths) })),
);
const attributedIds = new Set(attributed.map((a) => a.sword.id));
const relatedExhibitions = exhibitions.filter((ex) =>
  ex.exhibits.some((e) => e.smith_id === smith.id || (e.sword_id !== undefined && attributedIds.has(e.sword_id))),
);
const teachers = (smith.teacher_ids ?? []).map((id) => smiths.find((s) => s.id === id)).filter((s) => s !== undefined);
---

<BaseLayout title={smith.name}>
  <h1 class="text-2xl">{smith.name}</h1>
  <p class="mb-4">{smith.reading}</p>
  {smith.confidence === "unverified" && <p class="mb-4 font-bold text-brand-accent">要確認</p>}

  <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
    {smith.aliases.length > 0 && <><dt>別表記</dt><dd>{smith.aliases.join("、")}</dd></>}
    {smith.generation && <><dt>代</dt><dd>{smith.generation}</dd></>}
    {smith.school && <><dt>流派</dt><dd>{smith.school}</dd></>}
    {smith.province && <><dt>国</dt><dd>{smith.province}</dd></>}
    {smith.era && <><dt>時代</dt><dd>{smith.era}</dd></>}
    {
      teachers.length > 0 && (
        <>
          <dt>師</dt>
          <dd>
            {teachers.map((t, i) => (
              <>
                {i > 0 && "・"}
                <a href={`/smiths/${t.id}`} class="underline">{t.name}</a>
              </>
            ))}
          </dd>
        </>
      )
    }
  </dl>

  {smith.description && <p class="mt-4">{smith.description}</p>}

  <section class="mt-6">
    <h2 class="mb-2 text-lg">この刀匠の刀剣</h2>
    {
      attributed.length === 0 ? (
        <p>登録されている刀剣はありません。</p>
      ) : (
        <ul class="list-disc pl-5">
          {attributed.map((a) => (
            <li>
              <a href={`/swords/${a.sword.id}`} class="underline">{a.name.heading}</a>
              <span class="text-sm">（{a.basis}）</span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    relatedExhibitions.length > 0 && (
      <section class="mt-6">
        <h2 class="mb-2 text-lg">この刀匠の作が出品される展覧会</h2>
        <ul class="list-disc pl-5">
          {relatedExhibitions.map((ex) => (
            <li>
              <a href={`/exhibitions/${ex.id}`} class="underline">{ex.title}</a>（{ex.start_date}〜{ex.end_date}）
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Sources sources={smith.sources} confidence={smith.confidence} />
</BaseLayout>
